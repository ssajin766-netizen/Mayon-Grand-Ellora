<!-- ==========================================================
     HOME DASHBOARD
========================================================== -->

<%- include("partials/header") %>


<div class="container py-5">

    <!-- ======================================================
         DASHBOARD HEADER
    ======================================================= -->

    <div class="text-center mb-5">

        <h1 class="dashboard-welcome-title fw-bold">

            <img
                src="/images/diversity.png"
                alt="Mayon Grand Ellora"
                class="dashboard-logo"
            >

            <span>
                Welcome to Mayon Grand Ellora
            </span>

        </h1>


        <p class="dashboard-subtitle text-muted fs-5">

            Manage your apartment services quickly and securely.

        </p>

    </div>


    <!-- ======================================================
         DASHBOARD CARDS
    ======================================================= -->

    <div class="row g-4">


        <!-- ==================================================
             RESIDENTS
        =================================================== -->

        <div class="col-lg-4 col-md-6">

            <a
                href="/residents"
                class="text-decoration-none"
            >

                <div class="card dashboard-card h-100 border-0 shadow-sm">

                    <img
                        src="/images/members.jpg"
                        class="card-img-top dashboard-image"
                        alt="Residents"
                    >


                    <div class="card-body text-center">

                        <div class="dashboard-icon bg-primary">

                            <i class="fas fa-users"></i>

                        </div>


                        <h4 class="fw-bold mt-3">

                            Residents

                        </h4>


                        <p class="text-muted">

                            View all residents and apartment owners.

                        </p>

                    </div>

                </div>

            </a>

        </div>



        <!-- ==================================================
             NOTICEBOARD
        =================================================== -->

        <div class="col-lg-4 col-md-6">

            <a
                href="/noticeboard"
                class="text-decoration-none"
            >

                <div class="card dashboard-card h-100 border-0 shadow-sm">

                    <img
                        src="/images/notice.jpg"
                        class="card-img-top dashboard-image"
                        alt="Noticeboard"
                    >


                    <div class="card-body text-center">

                        <div class="dashboard-icon bg-warning">

                            <i class="fas fa-bullhorn"></i>

                        </div>


                        <h4 class="fw-bold mt-3">

                            Noticeboard

                        </h4>


                        <p class="text-muted">

                            Read the latest society announcements.

                        </p>

                    </div>

                </div>

            </a>

        </div>



        <!-- ==================================================
             BILLS
        =================================================== -->

        <div class="col-lg-4 col-md-6">

            <a
                href="/bill"
                class="text-decoration-none"
            >

                <div class="card dashboard-card h-100 border-0 shadow-sm">

                    <img
                        src="/images/bill.jpg"
                        class="card-img-top dashboard-image"
                        alt="Bills"
                    >


                    <div class="card-body text-center">

                        <div class="dashboard-icon bg-success">

                            <i class="fas fa-file-invoice-dollar"></i>

                        </div>


                        <h4 class="fw-bold mt-3">

                            Maintenance Bills

                        </h4>


                        <p class="text-muted">

                            View and pay monthly maintenance bills.

                        </p>

                    </div>

                </div>

            </a>

        </div>



        <!-- ==================================================
             HELPDESK
        =================================================== -->

        <div class="col-lg-4 col-md-6">

            <a
                href="/helpdesk"
                class="text-decoration-none"
            >

                <div class="card dashboard-card h-100 border-0 shadow-sm">

                    <img
                        src="/images/helpdesk.jpg"
                        class="card-img-top dashboard-image"
                        alt="Helpdesk"
                    >


                    <div class="card-body text-center">

                        <div class="dashboard-icon bg-danger">

                            <i class="fas fa-headset"></i>

                        </div>


                        <h4 class="fw-bold mt-3">

                            Helpdesk

                        </h4>


                        <p class="text-muted">

                            Raise and manage maintenance complaints.

                        </p>

                    </div>

                </div>

            </a>

        </div>



        <!-- ==================================================
             EMERGENCY
        =================================================== -->

        <div class="col-lg-4 col-md-6">

            <a
                href="/contacts"
                class="text-decoration-none"
            >

                <div class="card dashboard-card h-100 border-0 shadow-sm">

                    <img
                        src="/images/contact.jpg"
                        class="card-img-top dashboard-image"
                        alt="Emergency"
                    >


                    <div class="card-body text-center">

                        <div class="dashboard-icon bg-info">

                            <i class="fas fa-phone-alt"></i>

                        </div>


                        <h4 class="fw-bold mt-3">

                            Emergency

                        </h4>


                        <p class="text-muted">

                            Access important emergency contact numbers.

                        </p>

                    </div>

                </div>

            </a>

        </div>



        <!-- ==================================================
             PROFILE
        =================================================== -->

        <div class="col-lg-4 col-md-6">

            <a
                href="/profile"
                class="text-decoration-none"
            >

                <div class="card dashboard-card h-100 border-0 shadow-sm">

                    <img
                        src="/images/profile.jpg"
                        class="card-img-top dashboard-image"
                        alt="Profile"
                    >


                    <div class="card-body text-center">

                        <div class="dashboard-icon bg-secondary">

                            <i class="fas fa-user-circle"></i>

                        </div>


                        <h4 class="fw-bold mt-3">

                            My Profile

                        </h4>


                        <p class="text-muted">

                            View and update your personal information.

                        </p>

                    </div>

                </div>

            </a>

        </div>


    </div>

</div>



<!-- ==========================================================
     DASHBOARD STYLES
========================================================== -->

<style>


/* ==========================================================
   DASHBOARD CARD
========================================================== */

.dashboard-card {

    border-radius: 20px;

    overflow: hidden;

    transition:
        transform .35s ease,
        box-shadow .35s ease;

}


.dashboard-card:hover {

    transform: translateY(-10px);

    box-shadow:
        0 20px 45px rgba(0, 0, 0, .15) !important;

}


/* ==========================================================
   WELCOME HEADER
========================================================== */

.dashboard-welcome-title {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 14px;

    flex-wrap: wrap;

    margin-bottom: 10px;

    /*
     * Force title to black.
     * This overrides Bootstrap and other
     * global h1 color rules.
     */

    color: #000000 !important;

}


/* ==========================================================
   WELCOME TITLE TEXT
========================================================== */

.dashboard-welcome-title span {

    color: #000000 !important;

}


/* ==========================================================
   WELCOME LOGO
========================================================== */

.dashboard-logo {

    width: 64px;

    height: 64px;

    object-fit: contain;

    flex-shrink: 0;

    display: block;

}


/* ==========================================================
   SUBTITLE
========================================================== */

.dashboard-subtitle {

    color: #6c757d !important;

    margin-bottom: 0;

}


/* ==========================================================
   DASHBOARD IMAGES
========================================================== */

.dashboard-image {

    width: 100%;

    height: 220px;

    object-fit: cover;

    display: block;

}


/* ==========================================================
   DASHBOARD ICON
========================================================== */

.dashboard-icon {

    width: 70px;

    height: 70px;

    border-radius: 50%;

    color: #ffffff;

    display: flex;

    justify-content: center;

    align-items: center;

    margin: -55px auto 20px;

    position: relative;

    font-size: 30px;

    border: 5px solid #ffffff;

}


/* ==========================================================
   CARD TITLE
========================================================== */

.dashboard-card h4 {

    color: #212529 !important;

}


/* ==========================================================
   CARD DESCRIPTION
========================================================== */

.dashboard-card p {

    font-size: 15px;

}


/* ==========================================================
   TABLET
========================================================== */

@media (max-width: 768px) {

    .dashboard-image {

        height: 180px;

    }


    .dashboard-logo {

        width: 58px;

        height: 58px;

    }

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 576px) {

    .container {

        padding-left: 14px !important;

        padding-right: 14px !important;

    }


    .dashboard-welcome-title {

        flex-direction: column;

        gap: 8px;

        font-size: 28px;

        line-height: 1.2;

        color: #000000 !important;

    }


    .dashboard-welcome-title span {

        color: #000000 !important;

        display: block;

    }


    .dashboard-logo {

        width: 62px;

        height: 62px;

        object-fit: contain;

    }


    .dashboard-subtitle {

        font-size: 16px !important;

    }


    .dashboard-image {

        height: 180px;

    }

}


/* ==========================================================
   SMALL MOBILE
========================================================== */

@media (max-width: 400px) {

    .dashboard-welcome-title {

        font-size: 25px;

        color: #000000 !important;

    }


    .dashboard-welcome-title span {

        color: #000000 !important;

    }


    .dashboard-logo {

        width: 64px;

        height: 64px;

        object-fit: contain;

    }

}

</style>



<%- include("partials/footer") %>